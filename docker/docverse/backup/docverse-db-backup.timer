# Dispara docverse-db-backup.service todo dia às 03:30 (horário do servidor).
# Persistent=true roda o backup perdido se a máquina estava desligada no horário.
[Unit]
Description=Backup diário do Postgres do Docverse

[Timer]
OnCalendar=*-*-* 03:30:00
RandomizedDelaySec=10min
Persistent=true

[Install]
WantedBy=timers.target
